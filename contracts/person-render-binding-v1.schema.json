{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urai.app/schemas/person-render-binding-v1.json",
  "title": "UrAi Person Render Binding Promotion Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion","bundleId","personOpaqueRef","modality","provider","providerResourceRef",
    "reviewState","reviewReceiptHash","sourceAuthorityHash","consentRefs","bindingState"
  ],
  "properties": {
    "schemaVersion": { "const": "urai-person-render-binding-v1" },
    "bundleId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
    "personOpaqueRef": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
    "modality": { "enum": ["voice","visual","motion"] },
    "provider": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
    "providerResourceRef": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
    "providerModelRef": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
    "reviewState": { "const": "ACCEPTED" },
    "reviewReceiptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceAuthorityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "consentRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" } },
    "bindingState": { "const": "promotion-candidate" },
    "syntheticOutputMayBecomeHistoricalSource": { "const": false },
    "providerOwnsCanonicalIdentity": { "const": false }
  }
}

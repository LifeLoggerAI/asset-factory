# Asset Factory Studio
# Copy to .env.local for local Next.js development or configure these in Vercel/Fly/Render.

# Runtime
NODE_ENV=development
ASSET_FACTORY_FORCE_LOCAL=true

# Local persistence / Firebase-backed collection names
ASSET_FACTORY_JOBS_COLLECTION=assetFactoryJobs
ASSET_FACTORY_ASSETS_COLLECTION=assetFactoryAssets
ASSET_FACTORY_GENERATED_PREFIX=asset-factory/generated

# Firebase Admin storage/persistence mode.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# Auth / API security.
ASSET_FACTORY_REQUIRE_API_KEY=false
ASSET_FACTORY_API_KEY=
ASSET_FACTORY_REQUIRE_AUTH=false
ASSET_FACTORY_REQUIRE_JWT_SIGNATURE=false
ASSET_FACTORY_ALLOW_LEGACY_HEADER_AUTH=false
JWT_SECRET=change-me-local-only
ASSET_FACTORY_JWT_HS256_SECRET=
ASSET_FACTORY_JWT_ISSUER=
ASSET_FACTORY_JWT_AUDIENCE=
ASSET_FACTORY_AUDIENCE=
ASSET_FACTORY_TENANT_CLAIM=tenantId
ASSET_FACTORY_ROLE_CLAIM=roles
ASSET_FACTORY_SERVICE_TOKEN=

# Durable queue mode.
ASSET_FACTORY_QUEUE_MODE=local-inline
ASSET_FACTORY_WORKER_URL=
ASSET_FACTORY_WORKER_SECRET=

# Per-tenant monthly quota guardrails.
ASSET_FACTORY_MAX_MONTHLY_JOBS=500
ASSET_FACTORY_MAX_MONTHLY_UNITS=5000
ASSET_FACTORY_MAX_MONTHLY_COST_CENTS=10000
# Conservative preflight estimates, not provider price claims.
ASSET_FACTORY_MAX_JOB_ESTIMATED_COST_CENTS=500
ASSET_FACTORY_IMAGE_ESTIMATED_COST_CENTS_PER_MEGAPIXEL=10
ASSET_FACTORY_MODEL3D_ESTIMATED_COST_CENTS_PER_JOB=100
ASSET_FACTORY_SPEECH_ESTIMATED_COST_CENTS_PER_SECOND=3
ASSET_FACTORY_SFX_ESTIMATED_COST_CENTS_PER_SECOND=5
ASSET_FACTORY_MUSIC_ESTIMATED_COST_CENTS_PER_SECOND=10
ASSET_FACTORY_VIDEO_ESTIMATED_COST_CENTS_PER_SECOND=100

# Media provider configuration.
# local-proof produces deterministic proof assets. Paid providers remain dormant until a modality is explicitly selected.
ASSET_FACTORY_MEDIA_PROVIDER=local-proof
ASSET_FACTORY_IMAGE_PROVIDER=local-proof
ASSET_FACTORY_MODEL3D_PROVIDER=local-proof
ASSET_FACTORY_AUDIO_PROVIDER=local-proof
ASSET_FACTORY_SFX_PROVIDER=local-proof
ASSET_FACTORY_MUSIC_PROVIDER=local-proof
ASSET_FACTORY_STT_PROVIDER=local-proof
# Maximum accepted source size for transcription uploads (50 MiB).
ASSET_FACTORY_STT_MAX_BYTES=52428800
ASSET_FACTORY_VIDEO_PROVIDER=local-proof
# Independent global kill switch. External selectors still cannot call providers unless this is deliberately true.
ASSET_FACTORY_PROVIDER_SPEND_AUTHORIZED=false
# There is intentionally no automatic external-provider failover: a fallback could spend money or change provenance.
# Switch modality selectors explicitly after governance/preflight instead.

# Server-side credentials only. Never expose these through NEXT_PUBLIC_*.
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
RUNWAYML_API_SECRET=
# Legacy compatibility only; prefer RUNWAYML_API_SECRET.
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
MESHY_API_KEY=
STABILITY_API_KEY=
FAL_KEY=

# Stability image fallback.
ASSET_FACTORY_STABILITY_IMAGE_SERVICE=core

# Provider safety guardrails.
ASSET_FACTORY_PROVIDER_TIMEOUT_MS=120000
ASSET_FACTORY_PROVIDER_MAX_BYTES=104857600
# Video renders are larger/longer and use their own stricter governed limits.
ASSET_FACTORY_VIDEO_PROVIDER_TIMEOUT_MS=900000
ASSET_FACTORY_VIDEO_PROVIDER_POLL_MS=2000
ASSET_FACTORY_VIDEO_PROVIDER_MAX_BYTES=536870912
ASSET_FACTORY_ALLOW_VIDEO_INPUT_OVERRIDES=false

# Generic provider model IDs by modality.
ASSET_FACTORY_GRAPHICS_MODEL=
ASSET_FACTORY_GRAPHICS_SIZE=1024x1024
ASSET_FACTORY_GRAPHICS_FORMAT=png
ASSET_FACTORY_MODEL3D_MODEL=
ASSET_FACTORY_AUDIO_MODEL=

# OpenAI image/speech lane.
ASSET_FACTORY_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
ASSET_FACTORY_OPENAI_IMAGE_FORMAT=png
ASSET_FACTORY_OPENAI_IMAGE_QUALITY=high
ASSET_FACTORY_OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
ASSET_FACTORY_OPENAI_VOICE=

# ElevenLabs lane. Voice identity is intentionally blank and fail-closed until UrAi approves a voice.
ELEVENLABS_VOICE_ID=
ASSET_FACTORY_ELEVENLABS_SPEECH_MODEL=eleven_v3
ASSET_FACTORY_ELEVENLABS_CONVERSATIONAL_MODEL=eleven_v3_conversational
ASSET_FACTORY_ELEVENLABS_LOW_LATENCY_MODEL=eleven_flash_v2_5
ASSET_FACTORY_ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v2
ASSET_FACTORY_ELEVENLABS_MUSIC_MODEL=music_v2_5
ASSET_FACTORY_ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_MUSIC_OUTPUT_FORMAT=auto
ELEVENLABS_ZERO_RETENTION=false

# Meshy 3D lane. Generated assets remain candidates until QA/promotion.
# Image/multi-image model is pinned. Text-to-3D uses ASSET_FACTORY_MESHY_TEXT_MODEL when set,
# otherwise the same pinned ASSET_FACTORY_MESHY_MODEL; no provider server-default is treated as authority.
ASSET_FACTORY_MESHY_MODEL=meshy-7.1
ASSET_FACTORY_MESHY_TEXT_MODEL=
ASSET_FACTORY_MESHY_MODEL_TYPE=standard
ASSET_FACTORY_MESHY_GEOMETRY_RESOLUTION=4k
ASSET_FACTORY_MESHY_TEXT_GEOMETRY_RESOLUTION=4k
ASSET_FACTORY_MESHY_MULTI_IMAGE_GEOMETRY_RESOLUTION=2k
ASSET_FACTORY_MESHY_TEXTURE_RESOLUTION=4k
ASSET_FACTORY_MESHY_AUTO_SIZE=true
ASSET_FACTORY_MESHY_POLL_MS=3000

# Governed video provider registry.
# Replicate can be an official owner/model or owner/model:version. Keep this pinned server-side.
ASSET_FACTORY_REPLICATE_VIDEO_MODEL=
# fal remains an explicitly pinned server-side endpoint.
ASSET_FACTORY_FAL_VIDEO_ENDPOINT=

# Runway direct API configuration.
# Text-only and image-conditioned Gen-4.5 generation share the verified image_to_video API path.
ASSET_FACTORY_RUNWAY_VIDEO_MODEL=gen4.5
ASSET_FACTORY_RUNWAY_API_VERSION=2024-11-06
# Set true only after the actual production Runway account exposes an eligible video model.
ASSET_FACTORY_RUNWAY_VIDEO_ACCOUNT_READY=false

# Replicate model registry.
ASSET_FACTORY_REPLICATE_GRAPHICS_MODEL=black-forest-labs/flux-schnell
ASSET_FACTORY_REPLICATE_MODEL3D_MODEL=tencent/hunyuan-3d-3.1:a2838628b41a2e0ee2eb19b3ea98a40d75f8d7639bf5a1ddd37ea299bb334854
ASSET_FACTORY_REPLICATE_AUDIO_MODEL=google/lyria-2
ASSET_FACTORY_REPLICATE_SPEECH_MODEL=minimax/speech-02-hd
ASSET_FACTORY_REPLICATE_SPEECH_VOICE=
ASSET_FACTORY_ALLOW_REPLICATE_MODEL_OVERRIDE=false
ASSET_FACTORY_ALLOW_REPLICATE_INPUT_OVERRIDES=false

# Stripe / billing webhooks if billing is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional observability and product analytics.
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

{
  "name": "asset-factory-root",
  "version": "1.2.0",
  "description": "URAI Asset Factory orchestration and production image forge",
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "stripe": "^19.3.0"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "install:all": "node scripts/setup-local.mjs",
    "test": "npm --prefix engine test && npm --prefix life-map-pipeline/functions test && node scripts/check-legacy-functions-boundary.mjs",
    "build": "npm --prefix life-map-pipeline/functions run build && node scripts/check-legacy-functions-boundary.mjs",
    "verify:local": "corepack enable && corepack prepare pnpm@9.15.9 --activate && npm run image:install && npm run build && npm test --if-present && npm run test:launch-readiness --if-present && npm run test:completion-lock --if-present && npm run image:check:version-contract && npm run image:check",
    "verify:production": "npm run verify:local && npm run deploy:verify",
    "verify:launch": "node scripts/verify-asset-factory-launch.mjs",
    "test:launch-readiness": "npm run test:provider-readiness && npm run check:chaos-credential-boundary && npm run test:studio-deploy-readiness && npm run test:hs256-production-readiness && npm run test:privacy-safety-readiness && npm run test:support-smoke-readiness && npm run test:production-target-boundary && npm run test:route-guards && npm run check:paid-workflow-boundary && npm run check:replicate-paid-smoke-boundary && npm run check:replicate-rollout-manual-only && npm run check:smoke-readonly-boundary",
    "test:provider-readiness": "node --test scripts/test-provider-readiness.mjs",
    "test:studio-deploy-readiness": "node scripts/test-studio-deploy-readiness.mjs",
    "test:hs256-production-readiness": "node scripts/test-hs256-production-readiness.mjs",
    "test:privacy-safety-readiness": "node scripts/test-privacy-safety-readiness.mjs",
    "test:support-smoke-readiness": "node scripts/test-support-smoke-readiness.mjs",
    "test:route-guards": "node scripts/check-asset-factory-route-guards.mjs",
    "test:implementation-audit-prompt": "node scripts/check-implementation-audit-prompt.mjs",
    "test:completion-lock": "node scripts/check-completion-lock.mjs && npm run test:implementation-audit-prompt",
    "check:release-evidence": "node scripts/check-release-evidence.mjs",
    "check:release-evidence:latest": "node scripts/check-latest-release-evidence.mjs",
    "check:deploy-workflow": "node scripts/check-deploy-workflow.mjs",
    "check:chaos-credential-boundary": "node scripts/check-chaos-credential-boundary.mjs",
    "check:paid-workflow-boundary": "python3 scripts/check-paid-workflow-boundary-current.py && python3 scripts/test-paid-workflow-boundary.py && python3 scripts/test-paid-workflow-current-authorities.py",
    "check:replicate-paid-smoke-boundary": "node scripts/check-replicate-paid-smoke-boundary.mjs",
    "check:smoke-readonly-boundary": "node scripts/test-smoke-readonly-boundary.mjs",
    "finite-time:animatic": "node film_foundry/finite_time/generate-animatic.mjs",
    "finite-time:validate": "node film_foundry/finite_time/validate-animatic.mjs",
    "finite-time:storyboard-v2": "node film_foundry/finite_time/generate-storyboard-v2.mjs",
    "finite-time:validate-v2": "node film_foundry/finite_time/validate-storyboard-v2.mjs",
    "finite-time:validate-authorization": "node film_foundry/finite_time/validate-final-render-authorization.mjs",
    "finite-time:proof": "npm run finite-time:animatic && npm run finite-time:validate && npm run finite-time:storyboard-v2 && npm run finite-time:validate-v2 && npm run finite-time:validate-authorization",
    "image:install": "python -m pip install -r image_asset_generator/requirements.txt",
    "image:manifest": "python image_asset_generator/validate_manifest.py",
    "image:generate": "python image_asset_generator/generate_assets.py",
    "image:upgrade": "ASSET_RENDERER_FORCE=1 python image_asset_generator/generate_assets.py",
    "image:validate": "python image_asset_generator/validate_assets.py",
    "image:score": "python image_asset_generator/score_v1_assets.py",
    "image:preview": "python image_asset_generator/create_preview.py",
    "image:seed": "python image_asset_generator/create_firebase_seed.py",
    "image:export": "python image_asset_generator/export_assets.py",
    "image:handoff:spatial": "python image_asset_generator/export_spatial_handoff.py",
    "image:forge:v1": "ASSET_RENDERER_MODE=provider ASSET_FORGE_REQUIRE_PROVIDER=1 python image_asset_generator/forge_v1.py",
    "image:forge:v1:offline-proof": "ASSET_RENDERER_MODE=offline ASSET_FORGE_REQUIRE_PROVIDER=0 python image_asset_generator/forge_v1.py",
    "image:check:version-contract": "python image_asset_generator/check_canonical_version_contract.py",
    "image:check": "python image_asset_generator/run_pipeline.py",
    "image:wheel": "npm run image:manifest && npm run image:generate && npm run image:validate && npm run image:score && npm run image:preview && npm run image:seed && npm run image:export && npm run image:handoff:spatial",
    "audit:root": "pnpm audit --audit-level=high",
    "audit:functions": "npm --prefix life-map-pipeline/functions audit --audit-level=high",
    "audit:all": "npm run audit:production",
    "lockfile:refresh-root": "pnpm install --lockfile-only && npm run audit:root",
    "lockfile:refresh-functions": "node scripts/refresh-functions-lockfile.mjs",
    "diagnose:custom-domain": "node scripts/diagnose-custom-domain.mjs",
    "deploy:firebase": "node scripts/run-dedicated-firebase-deploy.mjs --only hosting,functions,firestore,storage",
    "deploy:hosting-rules": "node scripts/run-dedicated-firebase-deploy.mjs --only hosting,firestore,storage",
    "deploy:functions": "node scripts/run-dedicated-firebase-deploy.mjs --only functions",
    "deploy:studio": "npm --prefix assetfactory-studio run check && node scripts/run-dedicated-firebase-deploy.mjs --cwd assetfactory-studio --only hosting",
    "deploy:verify": "npm run validate:production-target && npm run smoke:production-finalization",
    "deploy:verify-readonly": "npm run validate:production-target && ASSET_FACTORY_SMOKE_READONLY=true npm run smoke:production-finalization",
    "deploy:verify-custom-domain": "ASSET_FACTORY_BASE_URL=https://www.uraiassetfactory.com ASSET_FACTORY_SMOKE_READONLY=true npm run smoke-production-finalization",
    "deploy:production": "npm run verify:local && npm run deploy:studio && npm run deploy:verify",
    "deploy:partial": "npm run verify:local && npm run deploy:hosting-rules && npm run deploy:verify-readonly",
    "smoke:remote": "node scripts/smoke-asset-factory-remote.mjs",
    "smoke:staging": "node scripts/smoke-asset-factory-remote.mjs",
    "smoke:prod": "node scripts/smoke-production-finalization.mjs",
    "smoke:production-finalization": "node scripts/smoke-production-finalization.mjs",
    "smoke:website": "ASSET_FACTORY_SMOKE_READONLY=true node scripts/smoke-production-finalization.mjs",
    "finish:custom-domain": "node scripts/finish-custom-domain-production.mjs",
    "validate:production-target": "node scripts/run-dedicated-firebase-deploy.mjs --check-only",
    "test:production-target-boundary": "node scripts/test-production-target-boundary.mjs",
    "audit:production": "pnpm audit --audit-level=high --prod && npm --prefix life-map-pipeline/functions audit --audit-level=high --omit=dev && npm --prefix engine audit --audit-level=high --omit=dev",
    "audit:workspace-debt": "pnpm audit --audit-level=high",
    "check:replicate-rollout-manual-only": "node scripts/check-replicate-rollout-manual-only.mjs",
    "test:adam-digital-human-authority": "node scripts/test-adam-digital-human-authority.mjs"
  },
  "pnpm": {
    "overrides": {
      "protobufjs@>=7 <8": "7.6.6",
      "protobufjs-cli@>=1 <2": "1.3.2",
      "websocket-driver@>=0.7 <0.8": "0.7.5",
      "minimatch@>=5 <6": "5.1.8",
      "minimatch@>=9 <10": "9.0.7",
      "path-to-regexp@>=0.1 <0.2": "0.1.13",
      "@grpc/grpc-js@>=1 <2": "1.14.4",
      "tmp@>=0.2 <0.3": "0.2.7",
      "linkify-it@>=5 <6": "5.0.2",
      "brace-expansion@>=2 <3": "2.1.4",
      "fast-uri@>=3 <4": "3.1.6",
      "ip-address@>=10 <11": "10.3.1",
      "fast-xml-parser@>=5 <6": "5.10.1",
      "browserslist@>=4 <5": "4.28.7"
    }
  }
}
